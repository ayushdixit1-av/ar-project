# GEMINI_API_KEY: Required for Gemini AI API calls (AI Professor / diagnosis features).
# Get a key from https://aistudio.google.com/apikey and set it in a local .env file.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted (used for self-referential links / callbacks).
# For local development, leave as default.
APP_URL="http://localhost:5173"
